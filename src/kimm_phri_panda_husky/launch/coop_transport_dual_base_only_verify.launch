<launch>
  <arg name="scenario" default="straight"/>
  <arg name="duration" default="4.0"/>
  <arg name="loop" default="false"/>
  <arg name="rate" default="10.0"/>
  <arg name="command_rate" default="25.0"/>
  <arg name="speed" default="0.01"/>
  <arg name="yaw_rate" default="0.08"/>
  <arg name="sim_start_delay" default="1.0"/>
  <arg name="merger_start_delay" default="2.0"/>
  <arg name="model_file" default="$(find husky_description)/husky_coop/coop_transport_scene.xml"/>

  <arg name="scene_log_output" default="/tmp/mm_verify_logs/dual_base_only_scene.csv"/>
  <arg name="reference_log_output" default="/tmp/mm_verify_logs/dual_base_only_reference.csv"/>
  <arg name="leader_controller_log_output" default="/tmp/mm_verify_logs/dual_base_only_leader.csv"/>
  <arg name="follower_controller_log_output" default="/tmp/mm_verify_logs/dual_base_only_follower.csv"/>

  <arg name="force_limit" default="18.0"/>
  <arg name="k_forward" default="10.0"/>
  <arg name="k_turn" default="18.0"/>
  <arg name="k_lateral_turn" default="4.0"/>
  <arg name="yaw_align_threshold" default="0.35"/>
  <arg name="max_xy_error" default="2.5"/>
  <arg name="kp_arm" default="2.0"/>
  <arg name="kd_arm" default="0.4"/>
  <arg name="arm_torque_limit" default="6.0"/>

  <include file="$(find kimm_phri_panda_husky)/launch/coop_transport_verify.launch">
    <arg name="scenario" value="$(arg scenario)"/>
    <arg name="duration" value="$(arg duration)"/>
    <arg name="loop" value="$(arg loop)"/>
    <arg name="rate" value="$(arg rate)"/>
    <arg name="speed" value="$(arg speed)"/>
    <arg name="yaw_rate" value="$(arg yaw_rate)"/>
    <arg name="sim_start_delay" value="$(arg sim_start_delay)"/>
    <arg name="model_file" value="$(arg model_file)"/>
    <arg name="scene_log_output" value="$(arg scene_log_output)"/>
    <arg name="reference_log_output" value="$(arg reference_log_output)"/>
  </include>

  <node name="leader_base_only_controller"
        pkg="kimm_phri_panda_husky" type="leader_base_only_controller.py" output="screen">
    <param name="rate" value="$(arg command_rate)"/>
    <param name="duration" value="$(arg duration)"/>
    <param name="output" value="$(arg leader_controller_log_output)"/>
    <param name="force_limit" value="$(arg force_limit)"/>
    <param name="k_forward" value="$(arg k_forward)"/>
    <param name="k_turn" value="$(arg k_turn)"/>
    <param name="k_lateral_turn" value="$(arg k_lateral_turn)"/>
    <param name="yaw_align_threshold" value="$(arg yaw_align_threshold)"/>
    <param name="max_xy_error" value="$(arg max_xy_error)"/>
    <param name="kp_arm" value="$(arg kp_arm)"/>
    <param name="kd_arm" value="$(arg kd_arm)"/>
    <param name="arm_torque_limit" value="$(arg arm_torque_limit)"/>
  </node>

  <node name="follower_base_only_separated_controller"
        pkg="kimm_phri_panda_husky" type="follower_base_only_separated_controller.py" output="screen">
    <param name="rate" value="$(arg command_rate)"/>
    <param name="duration" value="$(arg duration)"/>
    <param name="output" value="$(arg follower_controller_log_output)"/>
    <param name="force_limit" value="$(arg force_limit)"/>
    <param name="k_forward" value="$(arg k_forward)"/>
    <param name="k_turn" value="$(arg k_turn)"/>
    <param name="k_lateral_turn" value="$(arg k_lateral_turn)"/>
    <param name="yaw_align_threshold" value="$(arg yaw_align_threshold)"/>
    <param name="max_xy_error" value="$(arg max_xy_error)"/>
    <param name="kp_arm" value="$(arg kp_arm)"/>
    <param name="kd_arm" value="$(arg kd_arm)"/>
    <param name="arm_torque_limit" value="$(arg arm_torque_limit)"/>
  </node>

  <node name="dual_joint_set_merger"
        pkg="kimm_phri_panda_husky" type="dual_joint_set_merger.py" output="screen">
    <param name="rate" value="$(arg command_rate)"/>
    <param name="timeout" value="0.5"/>
    <param name="start_delay" value="$(arg merger_start_delay)"/>
  </node>
</launch>
