<launch>
  <arg name="scenario" default="straight"/>
  <arg name="duration" default="6.0"/>
  <arg name="rate" default="20.0"/>
  <arg name="command_rate" default="100.0"/>
  <arg name="speed" default="0.03"/>
  <arg name="yaw_rate" default="0.08"/>
  <arg name="sim_start_delay" default="1.0"/>
  <arg name="scene_log_output" default="/tmp/mm_verify_logs/base_arm_home_scene.csv"/>
  <arg name="reference_log_output" default="/tmp/mm_verify_logs/base_arm_home_reference.csv"/>
  <arg name="controller_log_output" default="/tmp/mm_verify_logs/base_arm_home_controller.csv"/>

  <arg name="base_force_limit" default="30.0"/>
  <arg name="k_forward" default="10.0"/>
  <arg name="k_turn" default="35.0"/>
  <arg name="k_lateral_turn" default="5.0"/>
  <arg name="yaw_align_threshold" default="0.35"/>

  <arg name="kp_arm" default="6.0"/>
  <arg name="kd_arm" default="0.8"/>
  <arg name="arm_torque_limit" default="12.0"/>
  <arg name="use_initial_arm_as_home" default="false"/>
  <arg name="seed_mode" default="home"/>
  <arg name="cm_seed_table_path" default="/tmp/mm_verify_logs/offline_cm_samples.csv"/>

  <include file="$(find kimm_phri_panda_husky)/launch/coop_transport_verify.launch">
    <arg name="scenario" value="$(arg scenario)"/>
    <arg name="duration" value="$(arg duration)"/>
    <arg name="rate" value="$(arg rate)"/>
    <arg name="speed" value="$(arg speed)"/>
    <arg name="yaw_rate" value="$(arg yaw_rate)"/>
    <arg name="sim_start_delay" value="$(arg sim_start_delay)"/>
    <arg name="scene_log_output" value="$(arg scene_log_output)"/>
    <arg name="reference_log_output" value="$(arg reference_log_output)"/>
  </include>

  <node name="follower_base_arm_home_controller"
        pkg="kimm_phri_panda_husky" type="follower_base_arm_home_controller.py" output="screen">
    <param name="rate" value="$(arg command_rate)"/>
    <param name="duration" value="$(arg duration)"/>
    <param name="output" value="$(arg controller_log_output)"/>
    <param name="base_force_limit" value="$(arg base_force_limit)"/>
    <param name="k_forward" value="$(arg k_forward)"/>
    <param name="k_turn" value="$(arg k_turn)"/>
    <param name="k_lateral_turn" value="$(arg k_lateral_turn)"/>
    <param name="yaw_align_threshold" value="$(arg yaw_align_threshold)"/>
    <param name="kp_arm" value="$(arg kp_arm)"/>
    <param name="kd_arm" value="$(arg kd_arm)"/>
    <param name="arm_torque_limit" value="$(arg arm_torque_limit)"/>
    <param name="use_initial_arm_as_home" value="$(arg use_initial_arm_as_home)"/>
    <param name="seed_mode" value="$(arg seed_mode)"/>
    <param name="cm_seed_table_path" value="$(arg cm_seed_table_path)"/>
  </node>
</launch>
