<launch>
  <arg name="scenario" default="straight"/>
  <arg name="duration" default="8.0"/>
  <arg name="speed" default="0.03"/>
  <arg name="sim_start_delay" default="1.0"/>
  <arg name="seed_type" default="baseline_home"/>
  <arg name="scene_log_output" default="/tmp/mm_verify_logs/experiment_scene.csv"/>
  <arg name="reference_log_output" default="/tmp/mm_verify_logs/experiment_reference.csv"/>
  <arg name="cm_seed_output" default="/tmp/mm_verify_logs/experiment_cm_seed.csv"/>

  <include file="$(find kimm_phri_panda_husky)/launch/coop_transport_baseline_demo.launch">
    <arg name="scenario" value="$(arg scenario)"/>
    <arg name="duration" value="$(arg duration)"/>
    <arg name="speed" value="$(arg speed)"/>
    <arg name="sim_start_delay" value="$(arg sim_start_delay)"/>
    <arg name="scene_log_output" value="$(arg scene_log_output)"/>
    <arg name="reference_log_output" value="$(arg reference_log_output)"/>
  </include>

  <node name="cm_seed_logger" pkg="kimm_phri_panda_husky" type="cm_seed_logger.py" output="screen">
    <param name="duration" value="$(arg duration)"/>
    <param name="output" value="$(arg cm_seed_output)"/>
    <param name="seed_type" value="$(arg seed_type)"/>
  </node>
</launch>
